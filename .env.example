# Application
NODE_ENV=development
PORT=3000

# Database (Azure DB Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stc_db?sslmode=disable

# Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Upstream OKIS API
OKIS_API_BASE_URL=https://api.okis.example.com
OKIS_API_KEY=your-okis-api-key-here

# Telemetry & Monitoring (Azure Log Analytics)
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_LOG_ANALYTICS_SHARED_KEY=

